{
  "color": {
    "$type": "color",
    "bg": {
      "canvas":         { "$value": "{color.neutral.950}" },
      "surface":        { "$value": "{color.neutral.850}" },
      "surface-hover":  { "$value": "{color.neutral.800}" },
      "overlay":        { "$value": "#000000b3" }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.100}" },
      "muted":     { "$value": "{color.neutral.300}" },
      "on-accent": { "$value": "{color.neutral.950}" }
    },
    "brand": {
      "accent":       { "$value": "{color.blue.300}" },
      "accent-hover": { "$value": "{color.blue.400}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.800}" },
      "focus":   { "$value": "{color.blue.300}" }
    },
    "status": {
      "success": { "$value": "{color.green.400}" }
    }
  }
}
