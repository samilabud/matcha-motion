{
  "color": {
    "$type": "color",
    "bg": {
      "canvas":         { "$value": "{color.neutral.50}" },
      "surface":        { "$value": "{color.neutral.0}" },
      "surface-hover":  { "$value": "{color.neutral.100}" },
      "overlay":        { "$value": "#0f121a99" }
    },
    "text": {
      "primary":   { "$value": "{color.neutral.900}" },
      "muted":     { "$value": "{color.neutral.500}" },
      "on-accent": { "$value": "{color.neutral.0}" }
    },
    "brand": {
      "accent":       { "$value": "{color.blue.600}" },
      "accent-hover": { "$value": "{color.blue.700}" }
    },
    "border": {
      "default": { "$value": "{color.neutral.200}" },
      "focus":   { "$value": "{color.blue.600}" }
    },
    "status": {
      "success": { "$value": "{color.green.600}" }
    }
  },
  "radius": {
    "$type": "dimension",
    "control": { "$value": "{radius.sm}" },
    "card":    { "$value": "{radius.md}" },
    "sheet":   { "$value": "{radius.lg}" }
  }
}
